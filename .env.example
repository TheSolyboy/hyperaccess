# The key every client must send, either in the x-api-key header
# or as an ?api_key= query parameter.
# Generate one with: openssl rand -hex 32
API_KEY=replace-me

# Port the server listens on.
PORT=3420

# Address the server binds to.
# 127.0.0.1 = localhost only (recommended; expose externally via a tunnel).
# 0.0.0.0   = all network interfaces.
HOST=127.0.0.1

# Maximum runtime per command in milliseconds. 0 = no timeout.
COMMAND_TIMEOUT_MS=0

# Maximum number of stdout/stderr bytes captured per command.
MAX_OUTPUT_BYTES=10485760
